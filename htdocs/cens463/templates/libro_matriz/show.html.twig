{% extends 'base.html.twig' %}

{% block title %}LibroMatriz{% endblock %}

{% block body %}
    <h1>LibroMatriz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ libro_matriz.id }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ libro_matriz.fecha ? libro_matriz.fecha|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Tomo</th>
                <td>{{ libro_matriz.tomo }}</td>
            </tr>
            <tr>
                <th>Folio</th>
                <td>{{ libro_matriz.folio }}</td>
            </tr>
            <tr>
                <th>Observaciones</th>
                <td>{{ libro_matriz.observaciones }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_libro_matriz_index') }}">back to list</a>

    <a href="{{ path('app_libro_matriz_edit', {'id': libro_matriz.id}) }}">edit</a>

    {{ include('libro_matriz/_delete_form.html.twig') }}
{% endblock %}
