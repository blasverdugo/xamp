{% extends 'base.html.twig' %}

{% block title %}Estudiante{% endblock %}

{% block body %}
    <h1>Estudiante</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ estudiante.id }}</td>
            </tr>
            <tr>
                <th>Apellido</th>
                <td>{{ estudiante.apellido }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ estudiante.nombre }}</td>
            </tr>
            <tr>
                <th>Dni</th>
                <td>{{ estudiante.dni }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ estudiante.fecha ? estudiante.fecha|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Localidad</th>
                <td>{{ estudiante.localidad }}</td>
            </tr>
            <tr>
                <th>Nacionalidad</th>
                <td>{{ estudiante.nacionalidad }}</td>
            </tr>
            <tr>
                <th>Genero</th>
                <td>{{ estudiante.genero }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_estudiante_index') }}">back to list</a>

    <a href="{{ path('app_estudiante_edit', {'id': estudiante.id}) }}">edit</a>

    {{ include('estudiante/_delete_form.html.twig') }}
{% endblock %}
