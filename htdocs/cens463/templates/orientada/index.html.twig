{% extends 'base.html.twig' %}

{% block title %}Orientada index{% endblock %}

{% block body %}
    <h1>Orientada index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Fecha</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for orientada in orientadas %}
            <tr>
                <td>{{ orientada.id }}</td>
                <td>{{ orientada.fecha ? orientada.fecha|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_orientada_show', {'id': orientada.id}) }}">show</a>
                    <a href="{{ path('app_orientada_edit', {'id': orientada.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_orientada_new') }}">Create new</a>
{% endblock %}
