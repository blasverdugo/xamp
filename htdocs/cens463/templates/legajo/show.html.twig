{% extends 'base.html.twig' %}

{% block title %}Legajo{% endblock %}

{% block body %}
    <h1>Legajo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ legajo.id }}</td>
            </tr>
            <tr>
                <th>Anio</th>
                <td>{{ legajo.anio }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ legajo.fecha ? legajo.fecha|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Turno</th>
                <td>{{ legajo.turno }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_legajo_index') }}">back to list</a>

    <a href="{{ path('app_legajo_edit', {'id': legajo.id}) }}">edit</a>

    {{ include('legajo/_delete_form.html.twig') }}
{% endblock %}
