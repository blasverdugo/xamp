{% extends 'base.html.twig' %}

{% block title %}Legajo index{% endblock %}

{% block body %}
    <h1>Legajo index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Anio</th>
                <th>Fecha</th>
                <th>Turno</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for legajo in legajos %}
            <tr>
                <td>{{ legajo.id }}</td>
                <td>{{ legajo.anio }}</td>
                <td>{{ legajo.fecha ? legajo.fecha|date('Y-m-d') : '' }}</td>
                <td>{{ legajo.turno }}</td>
                <td>
                    <a href="{{ path('app_legajo_show', {'id': legajo.id}) }}">show</a>
                    <a href="{{ path('app_legajo_edit', {'id': legajo.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_legajo_new') }}">Create new</a>
{% endblock %}
