{% extends 'base.html.twig' %}

{% block title %}Ciclo{% endblock %}

{% block body %}
    <h1>Ciclo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ciclo.id }}</td>
            </tr>
            <tr>
                <th>Tipo</th>
                <td>{{ ciclo.tipo }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ ciclo.nombre }}</td>
            </tr>
            <tr>
                <th>Resolucion</th>
                <td>{{ ciclo.resolucion.numero }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_ciclo_index') }}">back to list</a>

    <a href="{{ path('app_ciclo_edit', {'id': ciclo.id}) }}">edit</a>

    {{ include('ciclo/_delete_form.html.twig') }}
{% endblock %}
