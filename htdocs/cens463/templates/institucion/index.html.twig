{% extends 'base.html.twig' %}

{% block title %}Institucion index{% endblock %}

{% block body %}
    <h1>Institucion index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Numero</th>
                <th>Cue</th>
                <th>Fecha</th>
                <th>Email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for institucion in institucions %}
            <tr>
                <td>{{ institucion.id }}</td>
                <td>{{ institucion.nombre }}</td>
                <td>{{ institucion.numero }}</td>
                <td>{{ institucion.cue }}</td>
                <td>{{ institucion.fecha ? institucion.fecha|date('Y-m-d') : '' }}</td>
                <td>{{ institucion.email }}</td>
                <td>
                    <a href="{{ path('app_institucion_show', {'id': institucion.id}) }}">show</a>
                    <a href="{{ path('app_institucion_edit', {'id': institucion.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_institucion_new') }}">Create new</a>
{% endblock %}
